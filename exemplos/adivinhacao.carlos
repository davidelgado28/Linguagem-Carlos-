#include <carlinho.h>

int main() {
    int secreto = 42
    int palpite = 0
    int tentativas = 0

    cout << "Jogo da Adivinhação!" << "\n"
    cout << "Digite um número entre 1 e 100" << "\n"

    while palpite != secreto:
        cin >> palpite
        tentativas++

        if palpite == secreto:
            cout << "Acertou em " << tentativas << " tentativas!" << "\n"
        elif palpite > secreto:
            cout << "É menor..." << "\n"
        else:
            cout << "É maior..." << "\n"

    return 0
}
