#include <carlinho.h>

int main() {
    // for clássico
    for (int i = 0, i < 5, i++):
        cout << "i = " << i << "\n"

    // while com break/continue
    int vidas = 3
    while vidas > 0:
        vidas--
        cout << "Vidas: " << vidas << "\n"

    // do while
    int n = 10
    do {
        cout << "n = " << n << "\n"
        n++
    } while n < 3

    return 0
}
